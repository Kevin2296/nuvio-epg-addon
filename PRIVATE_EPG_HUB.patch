diff --git a/app/src/main/java/com/nuvio/tv/livetv/data/PrivateEpgHub.kt b/app/src/main/java/com/nuvio/tv/livetv/data/PrivateEpgHub.kt
new file mode 100644
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/livetv/data/PrivateEpgHub.kt
@@ -0,0 +1,33 @@
+package com.nuvio.tv.livetv.data
+
+/** Public guide downloads only: never send playlist metadata to the guide host. */
+object PrivateEpgHub {
+    data class Preset(val region: String, val label: String, val file: String) {
+        val url get() = "https://epgshare01.online/epgshare01/epg_ripper_$file.xml.gz"
+        val name get() = "EPG Hub · $label"
+    }
+
+    // Checked against the publisher's directory; availability and coverage can change.
+    val presets = listOf(
+        Preset("NL", "Nederland", "NL1"), Preset("BE", "België", "BE2"),
+        Preset("DE", "Duitsland", "DE1"), Preset("PL", "Polen", "PL1"),
+        Preset("US", "Verenigde Staten", "US2"), Preset("UK", "Verenigd Koninkrijk", "UK1")
+    )
+
+    data class Quality(val total: Int = 0, val current: Int = 0, val upcomingOnly: Int = 0) {
+        val missing get() = (total - current - upcomingOnly).coerceAtLeast(0)
+        val description get() = "$current nu · $upcomingOnly alleen later · $missing zonder komende gids"
+    }
+
+    /** Count intervals without retaining names, URLs, programme titles or credentials. */
+    fun quality(channels: Set<String>, schedules: Map<String, List<Pair<Long, Long>>>, now: Long): Quality {
+        var current = 0
+        var upcoming = 0
+        channels.forEach { key ->
+            val entries = schedules[key].orEmpty().filter { it.second > it.first }
+            if (entries.any { it.first <= now && it.second > now }) current++
+            else if (entries.any { it.first > now }) upcoming++
+        }
+        return Quality(channels.size, current, upcoming)
+    }
+}
diff --git a/app/src/test/java/com/nuvio/tv/livetv/data/PrivateEpgHubTest.kt b/app/src/test/java/com/nuvio/tv/livetv/data/PrivateEpgHubTest.kt
