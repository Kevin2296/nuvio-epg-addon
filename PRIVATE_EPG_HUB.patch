+++ b/app/src/test/java/com/nuvio/tv/livetv/data/PrivateEpgHubTest.kt
@@ -0,0 +1,36 @@
+package com.nuvio.tv.livetv.data
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class PrivateEpgHubTest {
+    @Test fun qualitySeparatesCurrentUpcomingExpiredAndMissing() {
+        val report = PrivateEpgHub.quality(setOf("a", "b", "c", "d"), mapOf(
+            "a" to listOf(80L to 110L, 120L to 130L),
+            "b" to listOf(120L to 130L),
+            "c" to listOf(50L to 100L),
+            "not-in-playlist" to listOf(80L to 110L)
+        ), 100L)
+        assertEquals(4, report.total)
+        assertEquals(1, report.current)
+        assertEquals(1, report.upcomingOnly)
+        assertEquals(2, report.missing)
+    }
+
+    @Test fun invalidIntervalsDoNotCountAsCoverage() {
+        assertEquals(1, PrivateEpgHub.quality(setOf("a"),
+            mapOf("a" to listOf(120L to 110L)), 100L).missing)
+    }
+
+    @Test fun presetsAreExplicitPublicHttpsFeedsWithoutCredentials() {
+        assertEquals(setOf("NL", "BE", "DE", "PL", "US", "UK"), PrivateEpgHub.presets.map { it.region }.toSet())
+        PrivateEpgHub.presets.forEach {
+            val uri = java.net.URI(it.url)
+            assertEquals("https", uri.scheme)
+            assertEquals("epgshare01.online", uri.host)
+            assertNull(uri.userInfo)
+            assertNull(uri.query)
+            assertTrue(uri.path.endsWith(".xml.gz"))
+        }
+    }
+}
